{
	"name": "vendure-plugin-it4billing",
	"version": "0.1.1",
	"description": "Vendure plugin that issues certified invoice-receipts in IT4Billing (Portugal) for orders, without a browser, and stores the PDF for customers to download",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"author": "afonsofigs",
	"license": "MIT",
	"keywords": [
		"vendure",
		"vendure-plugin",
		"vendure.io",
		"plugin",
		"it4billing",
		"invoice",
		"invoicing",
		"fatura",
		"faturacao",
		"portugal",
		"saft-pt"
	],
	"private": false,
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"url": "https://github.com/afonsofigs/vendure-plugin-it4billing.git",
		"type": "git"
	},
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write . && eslint . --fix",
		"typecheck": "tsc --noEmit -p tsconfig.check.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"build": "rimraf dist && tsc",
		"smoke": "node --import tsx scripts/smoke.ts"
	},
	"peerDependencies": {
		"@vendure/core": "^3.0.0",
		"typeorm": "*",
		"@nestjs/common": "*",
		"@nestjs/core": "*",
		"@nestjs/graphql": "*"
	},
	"packageManager": "pnpm@10.17.1",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@nestjs/apollo": "^13.4.5",
		"@nestjs/common": "^11.2.7",
		"@nestjs/core": "^11.2.7",
		"@nestjs/graphql": "13.2.3",
		"@nestjs/platform-express": "^11.2.7",
		"@types/node": "^20.19.43",
		"@vendure/common": "3.5.7",
		"@vendure/core": "3.5.7",
		"@vendure/testing": "3.5.7",
		"@vitest/coverage-istanbul": "^4.1.12",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"graphql": "^16.14.2",
		"prettier": "3.7.4",
		"rimraf": "^6.1.3",
		"sql.js": "^1.15.0",
		"tsx": "^4.23.15",
		"typeorm": "^0.3.31",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.71.2",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"graphql-tag": "^2.12.7",
		"node-html-parser": "^7.1.0",
		"pdf-lib": "^1.17.1"
	}
}
